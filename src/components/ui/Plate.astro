---
import type { EditorialImage } from '../../types/content';
interface Props {
  image: EditorialImage;
  priority?: boolean;
  sizes?: string;
}
const {
  image,
  priority = false,
  sizes = '(max-width: 760px) 100vw, 50vw',
} = Astro.props;
---

<img
  src={`${image.base}-1280.webp`}
  srcset={`${image.base}-640.webp 640w, ${image.base}-800.webp 800w, ${image.base}-1280.webp 1280w, ${image.base}-1600.webp 1600w`}
  sizes={sizes}
  alt={image.alt}
  width={image.width}
  height={image.height}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
/>
